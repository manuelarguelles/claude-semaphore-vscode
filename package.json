{
  "name": "claude-semaphore",
  "displayName": "Claude + Codex + OpenCode Semáforo",
  "description": "Organize, inspect and manage local Claude Code, Codex and OpenCode sessions in VS Code, with optional lifecycle signals.",
  "version": "1.1.2",
  "publisher": "manuelarguelles",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuelarguelles/claude-semaphore-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/manuelarguelles/claude-semaphore-vscode/issues"
  },
  "homepage": "https://github.com/manuelarguelles/claude-semaphore-vscode#readme",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agent",
    "sessions",
    "status",
    "semaphore",
    "traffic light",
    "codex"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSemaphore",
          "title": "Claude + Codex + OpenCode Semáforo",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSemaphore": [
        {
          "id": "claudeSemaphore.sessions",
          "name": "Sesiones"
        }
      ]
    },
    "configuration": {
      "title": "Claude + Codex + OpenCode Semáforo",
      "properties": {
        "claudeSemaphore.theme": {
          "type": "string",
          "enum": [
            "classic",
            "colorblind",
            "highContrast"
          ],
          "default": "classic",
          "description": "Paleta y formas del semáforo."
        },
        "claudeSemaphore.sound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Reproducir un sonido cuando una sesión pasa a amarillo (necesita atención)."
        },
        "claudeSemaphore.sound.file": {
          "type": "string",
          "default": "",
          "description": "Ruta a un sonido personalizado. Vacío = honk incluido."
        },
        "claudeSemaphore.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "Intervalo del sondeo de respaldo (ms)."
        },
        "claudeSemaphore.debug": {
          "type": "boolean",
          "default": false,
          "description": "Emite logs de diagnóstico [ClaudeSemaforo] en la consola del Extension Host."
        },
        "claudeSemaphore.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local Codex CLI sessions (macOS/Linux; requires lsof). Reads local events only; unrecorded permission prompts cannot be detected."
        },
        "claudeSemaphore.claude.path": {
          "type": "string",
          "default": "claude",
          "description": "Ruta al ejecutable de claude. Se detecta desde PATH y ubicaciones comunes."
        },
        "claudeSemaphore.codex.path": {
          "type": "string",
          "default": "codex",
          "description": "Ruta al ejecutable de codex. Se detecta desde PATH y ubicaciones comunes."
        },
        "claudeSemaphore.opencode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local OpenCode sessions (macOS/Linux; requires lsof, ps and sqlite3). Reads its local database only; pending permission prompts cannot be detected."
        },
        "claudeSemaphore.opencode.windowMs": {
          "type": "number",
          "default": 10,
          "description": "Ventana de actividad (minutos) para considerar viva una sesión de OpenCode compartida entre varios procesos."
        },
        "claudeSemaphore.opencode.path": {
          "type": "string",
          "default": "opencode",
          "description": "Ruta al ejecutable de opencode. Se detecta desde PATH y ubicaciones comunes."
        },
        "claudeSemaphore.hooks.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Ejecutable Node.js 18+ para hooks locales opcionales."
        }
      }
    },
    "colors": [
      {
        "id": "claudeSemaphore.classic.running",
        "description": "Running (classic)",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#3FB950"
        }
      },
      {
        "id": "claudeSemaphore.classic.needsInput",
        "description": "Needs input (classic)",
        "defaults": {
          "dark": "#D29922",
          "light": "#9A6700",
          "highContrast": "#D29922"
        }
      },
      {
        "id": "claudeSemaphore.classic.stopped",
        "description": "Idle / completed (not an error)",
        "defaults": {
          "dark": "#8B949E",
          "light": "#57606A",
          "highContrast": "#FFFFFF"
        }
      },
      {
        "id": "claudeSemaphore.colorblind.running",
        "description": "Running (colorblind)",
        "defaults": {
          "dark": "#0072B2",
          "light": "#0072B2",
          "highContrast": "#0072B2"
        }
      },
      {
        "id": "claudeSemaphore.colorblind.needsInput",
        "description": "Needs input (colorblind)",
        "defaults": {
          "dark": "#E69F00",
          "light": "#E69F00",
          "highContrast": "#E69F00"
        }
      },
      {
        "id": "claudeSemaphore.colorblind.stopped",
        "description": "Idle / completed (not an error)",
        "defaults": {
          "dark": "#8B949E",
          "light": "#57606A",
          "highContrast": "#FFFFFF"
        }
      },
      {
        "id": "claudeSemaphore.classic.error",
        "description": "Observed agent error",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#F85149"
        }
      },
      {
        "id": "claudeSemaphore.colorblind.error",
        "description": "Observed agent error",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#F85149"
        }
      }
    ],
    "commands": [
      {
        "command": "claudeSemaphore.revealTerminal",
        "title": "Revelar terminal",
        "category": "Claude Semáforo"
      },
      {
        "command": "claudeSemaphore.start",
        "title": "Iniciar sesión",
        "category": "Semáforo",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "claudeSemaphore.resume",
        "title": "Recuperar sesión",
        "category": "Semáforo",
        "icon": "$(history)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "claudeSemaphore.fork",
        "title": "Bifurcar sesión",
        "category": "Semáforo",
        "icon": "$(git-branch)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "claudeSemaphore.worktree",
        "title": "Crear sesión en worktree",
        "category": "Semáforo",
        "icon": "$(repo-forked)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "claudeSemaphore.search",
        "title": "Buscar sesiones",
        "category": "Semáforo",
        "icon": "$(search)"
      },
      {
        "command": "claudeSemaphore.filters",
        "title": "Filtrar sesiones",
        "category": "Semáforo",
        "icon": "$(filter)"
      },
      {
        "command": "claudeSemaphore.clearFilters",
        "title": "Limpiar filtros",
        "category": "Semáforo",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSemaphore.toggleGrouping",
        "title": "Alternar agrupación por proyecto",
        "category": "Semáforo",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeSemaphore.favorite",
        "title": "Alternar favorita",
        "category": "Semáforo",
        "icon": "$(star-empty)"
      },
      {
        "command": "claudeSemaphore.details",
        "title": "Ver información de sesión",
        "category": "Semáforo",
        "icon": "$(info)"
      },
      {
        "command": "claudeSemaphore.history",
        "title": "Ver historial local",
        "category": "Semáforo",
        "icon": "$(history)"
      },
      {
        "command": "claudeSemaphore.clearHistory",
        "title": "Limpiar historial local",
        "category": "Semáforo",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSemaphore.configureHooks",
        "title": "Configurar señales opcionales",
        "category": "Semáforo",
        "icon": "$(plug)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "claudeSemaphore.refresh",
        "title": "Actualizar sesiones",
        "category": "Semáforo",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "claudeSemaphore.revealTerminal",
          "when": "view == claudeSemaphore.sessions && viewItem == sessionWithTerminal",
          "group": "navigation"
        },
        {
          "command": "claudeSemaphore.details",
          "when": "view == claudeSemaphore.sessions && viewItem =~ /^session/",
          "group": "inline@1"
        },
        {
          "command": "claudeSemaphore.favorite",
          "when": "view == claudeSemaphore.sessions && viewItem =~ /^session/",
          "group": "inline@2"
        },
        {
          "command": "claudeSemaphore.resume",
          "when": "view == claudeSemaphore.sessions && viewItem =~ /^session/",
          "group": "1_manage"
        },
        {
          "command": "claudeSemaphore.fork",
          "when": "view == claudeSemaphore.sessions && viewItem =~ /^session/",
          "group": "1_manage"
        }
      ],
      "view/title": [
        {
          "command": "claudeSemaphore.start",
          "when": "view == claudeSemaphore.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeSemaphore.resume",
          "when": "view == claudeSemaphore.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudeSemaphore.search",
          "when": "view == claudeSemaphore.sessions",
          "group": "navigation@3"
        },
        {
          "command": "claudeSemaphore.filters",
          "when": "view == claudeSemaphore.sessions",
          "group": "navigation@4"
        },
        {
          "command": "claudeSemaphore.refresh",
          "when": "view == claudeSemaphore.sessions",
          "group": "navigation@5"
        },
        {
          "command": "claudeSemaphore.clearFilters",
          "when": "view == claudeSemaphore.sessions",
          "group": "1_filters"
        },
        {
          "command": "claudeSemaphore.toggleGrouping",
          "when": "view == claudeSemaphore.sessions",
          "group": "1_filters"
        },
        {
          "command": "claudeSemaphore.history",
          "when": "view == claudeSemaphore.sessions",
          "group": "2_history"
        },
        {
          "command": "claudeSemaphore.clearHistory",
          "when": "view == claudeSemaphore.sessions",
          "group": "2_history"
        },
        {
          "command": "claudeSemaphore.worktree",
          "when": "view == claudeSemaphore.sessions",
          "group": "3_manage"
        },
        {
          "command": "claudeSemaphore.configureHooks",
          "when": "view == claudeSemaphore.sessions",
          "group": "3_manage"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "package": "vsce package",
    "smoke:codex": "node scripts/smoke-codex.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "La observación está disponible; ejecución de agentes, Git y hooks requiere confianza.",
      "restrictedConfigurations": [
        "claudeSemaphore.claude.path",
        "claudeSemaphore.codex.path",
        "claudeSemaphore.opencode.path",
        "claudeSemaphore.hooks.nodePath"
      ]
    }
  }
}
